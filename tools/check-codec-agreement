#!/bin/sh
# Two directories of asn1c output. For every .c or .h file present in both,
# the code must be identical once each file's own asn1c-generated
# provenance comment is set aside -- see strip_banner() below for exactly
# what that comment is and why it always differs regardless of the code.
#
# This is what makes build/libeuicc-full.a safe. Almost every file in
# euicc-rsp's dist/ also exists in euicc-schema's, under the same name and
# defining the same strong symbols: the generic runtime (BER/DER, INTEGER,
# OCTET_STRING) and the PKIX types both a profile package and an RSP
# handshake reference. Two loose .o files defining one symbol is a link
# error; an archive member is not, because the linker only reaches into an
# archive for a symbol still outstanding. So the second copy is simply
# never used -- which is fine exactly as long as it would have made no
# difference. This checks that.
#
# The two are generated by the same asn1c binary (euicc-tools passes the
# one it built to both submodules) from what is meant to be the same PKIX
# source, so the code itself is the right bar: a difference there means the
# two projects' ASN.1 modules have diverged in a shared type, and the
# binary's behaviour then depends on link order rather than on intent. Five
# specific, named files are exempt from that bar; is_known_exception() below
# says which and why. Nothing else is.
set -u
[ $# -eq 2 ] || { echo "usage: $0 <dir-a> <dir-b>" >&2; exit 2; }
a=$1; b=$2
[ -d "$a" ] || { echo "not a directory: $a" >&2; exit 2; }
[ -d "$b" ] || { echo "not a directory: $b" >&2; exit 2; }

# The two arguments resolving to the same directory would make every check
# below pass by comparing a codec to itself -- proving nothing about
# whether euicc-schema's and euicc-rsp's independently generated copies
# agree. A misconfigured caller (RSP_DIST accidentally equal to DIST, or a
# copy-paste that passed $a twice) would hit exactly this, so it is
# rejected before anything else runs rather than silently trusted.
ra=$(cd "$a" && pwd -P) || exit 2
rb=$(cd "$b" && pwd -P) || exit 2
[ "$ra" != "$rb" ] || { echo "both arguments are the same directory: $ra" >&2; exit 2; }

# asn1c stamps every module-derived file (anything but a runtime skeleton
# copied verbatim from asn1c/skeletons) with a block comment naming the
# top-level .asn1 file and the exact `asn1c -S ...` command line that
# produced it. euicc-schema and euicc-rsp run the same asn1c binary against
# the same shared PKIX source, but as part of two different top-level
# module sets (profile-3.4.1.asn vs rsp-2.5.asn) and by two different -S
# spellings (relative when euicc-schema builds itself standalone, absolute
# when this Makefile drives euicc-rsp) -- so that comment differs on every
# module-derived file by construction, never because the file's own code
# differs. This drops exactly that comment: the leading /* ... */ block, if
# there is one, closing within the first 10 lines. A file that does not
# have that shape (no such block, or one that does not close early) is
# printed unchanged rather than emptied, so a file this was never meant for
# still gets compared, not silently skipped.
strip_banner() {
    awk '
        NR == 1 { if ($0 == "/*") { banner = 1; next } }
        banner && NR <= 10 {
            if ($0 == " */") banner = 0
            next
        }
        { print }
    ' "$1"
}

# Files that are allowed to differ, and why. Each name below was compared by
# hand against both dist/ directories before being added here; this is not
# a blanket exemption for a directory or a pattern, it is five specific
# files, each with a reason that does not generalise to any other file.
#
#   converter-example.c, pdu_collection.c -- asn1c writes one of each per
#     invocation, listing whatever PDUs that particular invocation compiled.
#     Every asn1c dist/ has a file with these names; their content is the
#     one place the two schemas are SUPPOSED to differ, not a case of drift.
#     (euicc-schema's own Makefile already excludes converter-example.c
#     from GEN_SRCS for the same reason.)
#
#   CertificateList.c, CertificateList.h -- rsp-2.5.asn uses CertificateList
#     as a struct member (SegmentedCrlList, EUICCInfo2); profile-3.4.1.asn
#     never references it. -pdu=auto sees a different reference graph in
#     the two invocations and picks a different storage class for the
#     type's helper array (static in euicc-schema's copy, extern in
#     euicc-rsp's) -- asn_DEF_CertificateList itself, the only symbol
#     anything outside the file calls, is identical either way. Harmless
#     specifically because euicc-schema's copy is the one always linked
#     (see build/libeuicc-full.a below); euicc-rsp's archived copy of this
#     file is provably never reached.
#
#   UICCCapability.h -- profile-3.4.1.asn and rsp-2.5.asn each define their
#     own UICCCapability from BIT STRING, independently -- it is not
#     IMPORTed from a shared module the way Certificate and CertificateList
#     are, so the two are free to name bits differently, and by SGP.22
#     version, they do (bit 8, and everything past bit 24). The generated
#     .c is identical but for the banner: named bits are a compile-time
#     enum, never a runtime symbol, and vn-annotate reads named bits only
#     from euicc-schema's own dist (see build/vn_annotations.c), never from
#     euicc-rsp's, so this file's divergence has no reader anywhere.
is_known_exception() {
    case "$1" in
        converter-example.c|pdu_collection.c|CertificateList.c|CertificateList.h|UICCCapability.h)
            return 0 ;;
        *)
            return 1 ;;
    esac
}

ta=$(mktemp) || exit 2
tb=$(mktemp) || exit 2
trap 'rm -f "$ta" "$tb"' EXIT

shared=0
bad=0
for pa in "$a"/*.c "$a"/*.h; do
    [ -f "$pa" ] || continue
    name=$(basename "$pa")
    pb="$b/$name"
    [ -f "$pb" ] || continue
    shared=$((shared + 1))

    is_known_exception "$name" && continue

    strip_banner "$pa" > "$ta"
    strip_banner "$pb" > "$tb"
    if ! cmp -s "$ta" "$tb"; then
        echo "differs: $name" >&2
        bad=$((bad + 1))
    fi
done

# No shared files at all would make this script pass for the wrong reason
# -- a mistyped path, or a dist/ that was never generated. The two codecs
# have hundreds of files in common; a handful means something is wrong.
if [ "$shared" -lt 50 ]; then
    echo "only $shared shared files between $a and $b -- expected hundreds;" >&2
    echo "one of these directories is probably not an asn1c dist" >&2
    exit 2
fi

if [ "$bad" -gt 0 ]; then
    echo "$bad of $shared shared generated files differ" >&2
    exit 1
fi
echo "$shared shared generated files, all identical (or a named, documented exception)"
exit 0

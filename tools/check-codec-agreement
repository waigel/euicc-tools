#!/bin/sh
# Two directories of asn1c output. For every .c or .h file present in both,
# the code must be identical once each file's own asn1c-generated
# provenance comment is set aside -- see strip_banner() below for exactly
# what that comment is and why it always differs regardless of the code.
#
# This is what makes build/libeuicc-full.a safe. Almost every file in
# euicc-rsp's dist/ also exists in euicc-schema's, under the same name and
# defining the same strong symbols: the generic runtime (BER/DER, INTEGER,
# OCTET_STRING) and the PKIX types both a profile package and an RSP
# handshake reference. Two loose .o files defining one symbol is a link
# error; an archive member is not, because the linker only reaches into an
# archive for a symbol still outstanding. So the second copy is simply
# never used -- which is fine exactly as long as it would have made no
# difference. This checks that.
#
# The two are generated by the same asn1c binary (euicc-tools passes the
# one it built to both submodules) from what is meant to be the same PKIX
# source, so the code itself is the right bar: a difference there means the
# two projects' ASN.1 modules have diverged in a shared type, and the
# binary's behaviour then depends on link order rather than on intent.
#
# Five files do not match byte for byte. Two of them differ all the way
# through and are exempt outright (is_known_exception below); the other
# three differ in one named way each, which normalise() removes so that
# the rest of those files is still held to the same bar. Nothing else is
# treated specially.
set -u
[ $# -eq 2 ] || { echo "usage: $0 <dir-a> <dir-b>" >&2; exit 2; }
a=$1; b=$2
[ -d "$a" ] || { echo "not a directory: $a" >&2; exit 2; }
[ -d "$b" ] || { echo "not a directory: $b" >&2; exit 2; }

# The two arguments resolving to the same directory would make every check
# below pass by comparing a codec to itself -- proving nothing about
# whether euicc-schema's and euicc-rsp's independently generated copies
# agree. A misconfigured caller (RSP_DIST accidentally equal to DIST, or a
# copy-paste that passed $a twice) would hit exactly this, so it is
# rejected before anything else runs rather than silently trusted.
ra=$(cd "$a" && pwd -P) || exit 2
rb=$(cd "$b" && pwd -P) || exit 2
[ "$ra" != "$rb" ] || { echo "both arguments are the same directory: $ra" >&2; exit 2; }

# asn1c stamps every module-derived file (anything but a runtime skeleton
# copied verbatim from asn1c/skeletons) with a block comment naming the
# top-level .asn1 file and the exact `asn1c -S ...` command line that
# produced it. euicc-schema and euicc-rsp run the same asn1c binary against
# the same shared PKIX source, but as part of two different top-level
# module sets (profile-3.4.1.asn vs rsp-2.5.asn) and by two different -S
# spellings (relative when euicc-schema builds itself standalone, absolute
# when this Makefile drives euicc-rsp) -- so that comment differs on every
# module-derived file by construction, never because the file's own code
# differs. This drops exactly that comment: the leading /* ... */ block, if
# there is one, closing within the first 10 lines. A file that does not
# have that shape (no such block, or one that does not close early) is
# printed unchanged rather than emptied, so a file this was never meant for
# still gets compared, not silently skipped.
strip_banner() {
    awk '
        NR == 1 { if ($0 == "/*") { banner = 1; next } }
        banner && NR <= 10 {
            if ($0 == " */") banner = 0
            next
        }
        { print }
    ' "$1"
}

# Two files are exempt outright, and only these two:
#
#   converter-example.c, pdu_collection.c -- asn1c writes one of each per
#     invocation, listing whatever PDUs that particular invocation compiled.
#     Every asn1c dist/ has a file with these names; their content is the
#     one place the two schemas are SUPPOSED to differ, top to bottom, not
#     a case of drift. There is no part of either file that both copies
#     should agree on, so there is nothing left to compare after removing
#     the difference. (euicc-schema's own Makefile already excludes
#     converter-example.c from GEN_SRCS for the same reason.)
is_known_exception() {
    case "$1" in
        converter-example.c|pdu_collection.c)
            return 0 ;;
        *)
            return 1 ;;
    esac
}

# Three more files differ, but only in one known, named way each -- so
# instead of exempting them, normalise away exactly that difference and
# compare everything else.
#
# The distinction matters more than it looks. Whole-file exemption stops
# checking the very property that justified the exemption: the reasoning
# below turns on asn_DEF_CertificateList being identical in both copies,
# and a file that is skipped can no longer tell you whether it still is.
# Appending an invented function to CertificateList.c used to leave this
# script reporting "all identical". Now it does not.
#
#   CertificateList.c -- rsp-2.5.asn uses CertificateList as a struct
#     member (SegmentedCrlList, EUICCInfo2); profile-3.4.1.asn never
#     references it. -pdu=auto sees a different reference graph in the two
#     invocations and picks a different storage class for the type's
#     helper array: `static asn_MBR_...` and `static asn_SPC_...` in
#     euicc-schema's copy, the same definitions without `static` in
#     euicc-rsp's. Drop the keyword on those two definitions and the rest
#     of the file -- asn_DEF_CertificateList included -- must match.
#
#   CertificateList.h -- the same divergence seen from the header side:
#     euicc-rsp's copy adds `extern` declarations for the two names its .c
#     no longer makes static. Drop those two lines; everything else must
#     match.
#
#   UICCCapability.h -- profile-3.4.1.asn and rsp-2.5.asn each define
#     their own UICCCapability from BIT STRING, independently. It is not
#     IMPORTed from a shared module the way Certificate and
#     CertificateList are, so the two are free to name bits differently,
#     and by SGP.22 version they do (bit 8, and everything past bit 24).
#     Named bits are a compile-time enum, never a runtime symbol, and
#     euicc-tools' own translation units never see euicc-rsp's copy of
#     this header (only $(DIST) is on the include path). Drop the enum
#     body; the struct, the descriptor declaration and everything else in
#     the file must still match.
normalise() {
    case "$1" in
        CertificateList.c)
            sed 's/^static \(asn_TYPE_member_t asn_MBR_CertificateList_1\)/\1/;
                 s/^static \(asn_SEQUENCE_specifics_t asn_SPC_CertificateList_specs_1\)/\1/' ;;
        CertificateList.h)
            grep -v '^extern asn_SEQUENCE_specifics_t asn_SPC_CertificateList_specs_1;$' \
              | grep -v '^extern asn_TYPE_member_t asn_MBR_CertificateList_1\[3\];$' ;;
        UICCCapability.h)
            # Everything but the body of the one `typedef enum ... {`
            # block. The braces of that block are kept, so a file that
            # lost the enum entirely still differs from one that has it.
            awk '
                /^typedef enum UICCCapability \{$/ { print; inenum = 1; next }
                inenum && /^\} / { inenum = 0 }
                inenum { next }
                { print }
            ' ;;
        *)
            cat ;;
    esac
}

ta=$(mktemp) || exit 2
tb=$(mktemp) || exit 2
trap 'rm -f "$ta" "$tb"' EXIT

shared=0
bad=0
for pa in "$a"/*.c "$a"/*.h; do
    [ -f "$pa" ] || continue
    name=$(basename "$pa")
    pb="$b/$name"
    [ -f "$pb" ] || continue
    shared=$((shared + 1))

    is_known_exception "$name" && continue

    strip_banner "$pa" | normalise "$name" > "$ta"
    strip_banner "$pb" | normalise "$name" > "$tb"
    if ! cmp -s "$ta" "$tb"; then
        echo "differs: $name" >&2
        bad=$((bad + 1))
    fi
done

# No shared files at all would make this script pass for the wrong reason
# -- a mistyped path, or a dist/ that was never generated. The two codecs
# have hundreds of files in common; a handful means something is wrong.
if [ "$shared" -lt 50 ]; then
    echo "only $shared shared files between $a and $b -- expected hundreds;" >&2
    echo "one of these directories is probably not an asn1c dist" >&2
    exit 2
fi

if [ "$bad" -gt 0 ]; then
    echo "$bad of $shared shared generated files differ" >&2
    exit 1
fi
echo "$shared shared generated files, all identical once the two per-invocation files are set aside"
exit 0

#!/bin/sh
# Every command, against a profile that must pass and one that must fail.
set -u
here=$(dirname "$0"); root=$(cd "$here/.." && pwd)
E="$root/euicc"
pass=0; fail=0
ok()   { printf 'ok   %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf 'FAIL %s\n' "$1"; fail=$((fail+1)); }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

cat > "$tmp/good.vn" <<'VN'
value1 ProfileElement ::= header : {
    major-version 2, minor-version 3,
    iccid '89000123456789012341'H,
    eUICC-Mandatory-services { usim NULL },
    eUICC-Mandatory-GFSTEList { { 2 23 143 1 2 1 } }
}
value2 ProfileElement ::= end : { end-header { mandated NULL, identification 99 } }
VN

"$E" build "$tmp/good.vn" -o "$tmp/good.der" 2>/dev/null && ok "build writes DER" || bad "build writes DER"

# metadata: the StoreMetadataRequest an SM-DP+ needs before any card is
# involved. The ICCID must come out nibble-swapped into EFiccid's
# ordering -- SGP.22 section 5.5.5 has the eUICC compare it against
# EFiccid itself, and an unswapped value fails the install only at the
# very end, reading like a profile fault.
"$E" metadata "$tmp/good.der" -o "$tmp/md.der" 2>"$tmp/md.err" \
    && ok "metadata writes a StoreMetadataRequest" \
    || bad "metadata writes a StoreMetadataRequest"
head -c2 "$tmp/md.der" | od -An -tx1 | tr -d ' \n' | grep -qi '^bf25' \
    && ok "...tagged BF25, as section 5.5.3 defines it" \
    || bad "...tagged BF25, as section 5.5.3 defines it"
grep -q "^iccid 98001032547698103214$" "$tmp/md.err" \
    && ok "...and it names the ICCID swapped into EFiccid ordering" \
    || bad "...and it names the ICCID swapped into EFiccid ordering"
"$E" metadata "$tmp/good.vn" >/dev/null 2>&1 \
    && bad "metadata refuses something that is not a profile" \
    || ok "metadata refuses something that is not a profile"
test -s "$tmp/good.der" && ok "the DER is not empty" || bad "the DER is not empty"
"$E" check "$tmp/good.der" >/dev/null 2>&1 && ok "a correct package passes" || bad "a correct package passes"
"$E" show "$tmp/good.der" 2>/dev/null | grep -q "major-version 2" \
  && ok "show writes value notation" || bad "show writes value notation"

# The header last: two ordering rules must catch it. Split on the second
# assignment rather than on a line number, which a reformat would invalidate.
awk '/^value2 /{p=1} p{e=e $0 "\n"; next} {h=h $0 "\n"}
     END{printf "%s%s", e, h}' "$tmp/good.vn" > "$tmp/bad.vn"
out=$("$E" check "$tmp/bad.vn" 2>&1)
echo "$out" | grep -q SAIP-HDR-02 && ok "the header must come first" || bad "the header must come first"
echo "$out" | grep -q SAIP-END-02 && ok "PE-End must come last"      || bad "PE-End must come last"
"$E" check "$tmp/bad.vn" >/dev/null 2>&1 && bad "a bad package exits non-zero" \
                                         || ok "a bad package exits non-zero"

# A size the schema forbids is caught before anything is written.
sed "s/'89000123456789012341'H/'8900'H/" "$tmp/good.vn" > "$tmp/short.vn"
"$E" build "$tmp/short.vn" -o "$tmp/short.der" 2>&1 | grep -q "constraint failed" \
  && ok "a short ICCID is refused" || bad "a short ICCID is refused"

# Every published profile must stay clean.
for d in "$root"/vendor/euicc-schema/testdata/*.der; do
  [ -f "$d" ] || continue
  "$E" check "$d" >/dev/null 2>&1 && ok "clean: $(basename "$d")" || bad "clean: $(basename "$d")"
done

# The examples the extension ships hold themselves to the strictest reading:
# no findings, not even warnings, and the canonical layout.
for v in "$root"/editors/vscode/examples/*.vn; do
  [ -f "$v" ] || continue
  "$E" check -t -s "$v" >/dev/null 2>&1 \
    && ok "example is spotless: $(basename "$v")" \
    || bad "example is spotless: $(basename "$v")"
  "$E" fmt -l "$v" >/dev/null 2>&1 \
    && ok "example is canonical: $(basename "$v")" \
    || bad "example is canonical: $(basename "$v")"
done

# diff: the same source against the package it produced shows nothing.
"$E" diff "$tmp/good.vn" "$tmp/good.der" 2>/dev/null | grep -q "no difference" \
  && ok "a source matches the package it built" || bad "a source matches the package it built"

sed 's/minor-version 3/minor-version 4/' "$tmp/good.vn" > "$tmp/v4.vn"
"$E" diff "$tmp/v4.vn" "$tmp/good.der" 2>/dev/null | grep -q "1 changed" \
  && ok "a changed value is reported" || bad "a changed value is reported"

# Order carries meaning here, and a hexdump does not show it.
"$E" diff "$tmp/bad.vn" "$tmp/good.der" 2>/dev/null | grep -q "different order" \
  && ok "a reordering is reported" || bad "a reordering is reported"

# Named numbers and named bits. asn1c parses these identifiers and keeps
# none of them, so vn-annotate recovers them into a table. The table was
# linked but never handed to the reader or the writer, and for as long as
# that was so, euicc rejected the form the specification itself prints.
cat > "$tmp/named.vn" <<'VN'
value1 ProfileElement ::= akaParameter : {
    aka-header { mandated NULL, identification 1 },
    algoConfiguration algoParameter : {
        algorithmID milenage,
        algorithmOptions '00'H,
        key '000102030405060708090A0B0C0D0E0F'H,
        opc '000102030405060708090A0B0C0D0E0F'H
    }
}
VN
sed 's/algorithmID milenage/algorithmID 1/' "$tmp/named.vn" > "$tmp/numeric.vn"
"$E" build "$tmp/named.vn" -o "$tmp/named.der" 2>/dev/null \
  && ok "a named number is read" || bad "a named number is read"
"$E" build "$tmp/numeric.vn" -o "$tmp/numeric.der" 2>/dev/null
cmp -s "$tmp/named.der" "$tmp/numeric.der" \
  && ok "the name and the number encode alike" || bad "the name and the number encode alike"
"$E" show "$tmp/named.der" 2>/dev/null | grep -q "algorithmID milenage" \
  && ok "show writes the name, not the number" || bad "show writes the name, not the number"

# A rejected build must say why. It exited 1 in silence until it did, which
# reads as a broken tool rather than as a wrong file.
sed 's/algorithmID milenage/algorithmID nonsense/' "$tmp/named.vn" > "$tmp/unknown.vn"
"$E" build "$tmp/unknown.vn" -o /dev/null 2>&1 | grep -q "line 4" \
  && ok "a rejected build names the line" || bad "a rejected build names the line"
"$E" show "$tmp/unknown.vn" 2>&1 | grep -q "nonsense" \
  && ok "a rejected show says what it choked on" || bad "a rejected show says what it choked on"

# schema: what an editor completes against. Checked against the ASN.1 source
# and not against itself, so a walk that quietly loses a branch is visible.
# Line-oriented on purpose: the dump puts one type and one member on a line
# each, which sed reads, so the test suite of a C program needs no interpreter.
"$E" schema > "$tmp/schema.json" 2>/dev/null

# The block of one type, from its opening line to the ]} that closes it.
blk() { sed -n "/^  \"$1\":/,/^  ]}/p" "$tmp/schema.json"; }

# Every member name in what is piped in. grep -o rather than a sed capture:
# `.*"name": "\(...\)"` is greedy, so two members on one line yield only the
# second, and an extra one goes unseen. The dump writes one per line today and
# this does not depend on it.
names() { grep -o '"name": "[^"]*"' | sed 's/^"name": "//; s/"$//'; }

grep -q '"root": "ProfileElement"' "$tmp/schema.json" \
  && ok "schema: the root is ProfileElement" || bad "schema: the root is ProfileElement"
grep -q '"ProfileElement": {"kind": "CHOICE"' "$tmp/schema.json" \
  && ok "schema: ProfileElement is a CHOICE" || bad "schema: ProfileElement is a CHOICE"

# Every alternative of the source CHOICE, one for one. A missing branch is the
# failure that matters here and it is invisible in a dump read on its own.
sed -n '/^ProfileElement[[:space:]]*::=/,/^}/p' \
    "$root/vendor/euicc-schema/profile-3.4.1.asn" \
  | sed -n 's/^[[:space:]]*\([a-z][A-Za-z0-9-]*\)[[:space:]][[:space:]]*[A-Za-z].*/\1/p' \
  | sort -u > "$tmp/want"
blk ProfileElement | names | sort -u > "$tmp/have"
if cmp -s "$tmp/want" "$tmp/have"; then
  ok "schema: every alternative of ProfileElement is present"
else
  bad "schema: every alternative of ProfileElement is present"
  comm -3 "$tmp/want" "$tmp/have" | sed 's/^/       /'
fi

# File ::= SEQUENCE OF CHOICE. The inline CHOICE is a level in the written
# value, so it must survive as a type of its own.
grep -q '"File": {"kind": "SEQUENCE OF", "of": "File__Member"}' "$tmp/schema.json" \
  && ok "schema: File is a SEQUENCE OF" || bad "schema: File is a SEQUENCE OF"
inner=$(blk File__Member | names | sort | tr '\n' ' ')
[ "$inner" = "doNotCreate fileDescriptor fillFileContent fillFileOffset " ] \
  && ok "schema: the inline CHOICE inside File is kept" \
  || bad "schema: the inline CHOICE inside File is kept ($inner)"

# OPTIONAL has to be right: the client offers a mandatory member first, and
# the reader rejects the value when one is left out.
blk ProfileHeader | grep -q '"name": "iccid", .*"optional": false' \
  && blk ProfileHeader | grep -q '"name": "profileType", .*"optional": true' \
  && ok "schema: OPTIONAL is carried through" || bad "schema: OPTIONAL is carried through"

# The identifiers only the annotation table knows.
blk AlgoParameter \
  | grep -q '"name": "algorithmID", .*"names": \["milenage", "tuak", "usim-test-algorithm"\]' \
  && ok "schema: named numbers reach the member" || bad "schema: named numbers reach the member"

sc=$("$E" schema 2>/dev/null | wc -c)
[ "$sc" -gt 10000 ] && ok "schema: the dump is not a stub" || bad "schema: the dump is not a stub"

# Where a parse failure is reported. The reader is handed one value at a time
# and counts from the start of it, so every failure in the second element used
# to arrive as line 1 and an editor marked the top of the file.
cat > "$tmp/pos.vn" <<'VN'
value1 ProfileElement ::= header : {
    major-version 2, minor-version 3,
    iccid '89000123456789012341'H,
    eUICC-Mandatory-services { usim NULL },
    eUICC-Mandatory-GFSTEList { { 2 23 143 1 2 1 } }
}
value2 ProfileElement ::= mf : {
    mf-header { mandated NULL, identification 1 },
    templateID { 2 23 143 1 2 1 },
    mf { fileDescriptor : { securityAttributesReferenced 42 } }
}
VN
out=$("$E" check -t --json "$tmp/pos.vn" 2>&1)
echo "$out" | grep -q '"line": 10' \
  && ok "a failure inside the second element names its own line" \
  || bad "a failure inside the second element names its own line ($out)"

# A missing member has no token to point at, so the reader points at the brace
# of the value that lacks it. That is the object, which is where an editor
# should mark it.
sed '10d' "$tmp/pos.vn" | sed 's/    templateID { 2 23 143 1 2 1 },/    templateID { 2 23 143 1 2 1 }/' > "$tmp/nomf.vn"
out=$("$E" check -t --json "$tmp/nomf.vn" 2>&1)
echo "$out" | grep -q "missing mandatory member" \
  && ok "a missing member is reported" || bad "a missing member is reported ($out)"
echo "$out" | grep -q '"line": 7, "column": 31' \
  && ok "a missing member is marked on the brace of its object" \
  || bad "a missing member is marked on the brace of its object ($out)"

# A type the schema does not allow, which is a parse failure and not a rule.
sed 's|iccid|profileType|' "$tmp/pos.vn" > "$tmp/wrongtype.vn"
out=$("$E" check -t --json "$tmp/wrongtype.vn" 2>&1)
echo "$out" | grep -q '"line": 3' \
  && ok "a value of the wrong type names its line" \
  || bad "a value of the wrong type names its line ($out)"

# SEQUENCE OF CHOICE. A CHOICE value is `alt : value` and carries no braces,
# so an element of such a list is written straight inside it. An editor has to
# know which of the two forms to insert, and this is where that is settled.
mfhead='value1 ProfileElement ::= mf : {
    mf-header { mandated NULL, identification 1 },
    templateID { 2 23 143 1 2 1 },'
printf '%s\n    mf { fileDescriptor : { securityAttributesReferenced %s2F0601%sH } }\n}\n' \
  "$mfhead" "'" "'" > "$tmp/flat.vn"
printf '%s\n    mf { { fileDescriptor : { securityAttributesReferenced %s2F0601%sH } } }\n}\n' \
  "$mfhead" "'" "'" > "$tmp/nested.vn"

# Both files lack other mandatory members, which is not what is under test:
# only whether the braces themselves are refused.
"$E" check -t --json "$tmp/flat.vn" 2>&1 | grep -q "expected an alternative name" \
  && bad "an element of a list of CHOICE needs no braces" \
  || ok "an element of a list of CHOICE needs no braces"
"$E" check -t --json "$tmp/nested.vn" 2>&1 | grep -q "expected an alternative name" \
  && ok "an element wrapped in braces is refused" \
  || bad "an element wrapped in braces is refused"

# fmt. It reads text and never goes through the writer, because `euicc show`
# re-serialises a decoded value and every comment in the file is gone. What it
# may not change is the token list, and that is what these check.
cat > "$tmp/messy.vn" <<'VN'
-- a header comment
myHeader ProfileElement ::= mf : {
    mf-header { mandated NULL, identification 1 },ef-dir {
        fileDescriptor : {
fileDescriptor '4221'H,      -- linear fixed, so four bytes
            fileID '2F00'H
        }
    }
}
VN
"$E" fmt "$tmp/messy.vn" > "$tmp/laid.vn" 2>/dev/null

grep -q '^    ef-dir {$' "$tmp/laid.vn" \
  && ok "fmt: a member after a closing brace starts a line" \
  || bad "fmt: a member after a closing brace starts a line"
grep -q '^        mandated NULL,$' "$tmp/laid.vn" \
  && ok "fmt: two members on one line become two" \
  || bad "fmt: two members on one line become two"
grep -q "^-- a header comment$" "$tmp/laid.vn" \
  && ok "fmt: a comment survives" || bad "fmt: a comment survives"
grep -q "linear fixed, so four bytes" "$tmp/laid.vn" \
  && ok "fmt: a trailing comment stays on its line" \
  || bad "fmt: a trailing comment stays on its line"
grep -q "myHeader" "$tmp/laid.vn" \
  && ok "fmt: the value reference keeps its name" \
  || bad "fmt: the value reference keeps its name"
"$E" fmt "$tmp/laid.vn" 2>/dev/null | cmp -s - "$tmp/laid.vn" \
  && ok "fmt: laying out twice is the same as once" \
  || bad "fmt: laying out twice is the same as once"

# A cstring is text and every character of one counts. X.680 12.11 and 12.12
# say the whitespace inside an hstring or a bstring is not, which is why a
# wrapped one may be reflowed and this may not.
printf 'value1 ProfileElement ::= header : {\n    profileType "first line   \nsecond line",\n    major-version 2\n}\n' \
  > "$tmp/cstr.vn"
"$E" fmt "$tmp/cstr.vn" 2>/dev/null | grep -q 'first line   $' \
  && ok "fmt: a string over lines is not shortened" \
  || bad "fmt: a string over lines is not shortened"

# An OBJECT IDENTIFIER is a brace list of arcs and the writer keeps it on one
# line. Breaking them put ninety extra lines in a published profile.
printf 'value1 ProfileElement ::= header : {\n eUICC-Mandatory-GFSTEList { { 2 23 143 1 2 1 } }\n}\n' \
  > "$tmp/oid.vn"
"$E" fmt "$tmp/oid.vn" 2>/dev/null | grep -q '{ 2 23 143 1 2 1 }' \
  && ok "fmt: an object identifier stays on one line" \
  || bad "fmt: an object identifier stays on one line"

# The writer and the formatter have to agree on what canonical means.
for d in "$root"/vendor/euicc-schema/testdata/*.der; do
  [ -f "$d" ] || continue
  "$E" show "$d" 2>/dev/null > "$tmp/canon.vn"
  "$E" fmt "$tmp/canon.vn" 2>/dev/null | cmp -s - "$tmp/canon.vn" \
    && ok "fmt: the writer output of $(basename "$d" .der | cut -c1-24) is unchanged" \
    || bad "fmt: the writer output of $(basename "$d" .der | cut -c1-24) is unchanged"
  break
done

# The comment rules are the reader's, from vn_token.c. X.680 12.6.3 ends a
# one-line comment at the next "--" as well as at the end of the line, and
# 12.6.4 nests the bracketed form. The first formatter ran every line comment
# to the end of the line, so `-- x -- y` was comment to the formatter and
# partly code to the reader -- two readings of one file.
printf 'value1 ProfileElement ::= header : {\n    major-version 2 -- note -- , minor-version 3\n}\n' > "$tmp/dd.vn"
"$E" fmt "$tmp/dd.vn" 2>/dev/null | grep -q '^    minor-version 3$' \
  && ok "fmt: a comment ends at the second --, as it does for the reader" \
  || bad "fmt: a comment ends at the second --, as it does for the reader"

printf '/* outer /* inner */ still comment */\nvalue1 ProfileElement ::= header : { major-version 2 }\n' > "$tmp/nest.vn"
"$E" fmt "$tmp/nest.vn" 2>/dev/null | grep -q 'still comment \*/$' \
  && ok "fmt: bracketed comments nest, as they do for the reader" \
  || bad "fmt: bracketed comments nest, as they do for the reader"

# It reads text, so it works on a file the reader rejects -- the file most in
# need of laying out.
printf 'value1 ProfileElement ::= header : {\nmajor-version nonsense\n}\n' > "$tmp/broken.vn"
"$E" fmt "$tmp/broken.vn" 2>/dev/null | grep -q '^    major-version nonsense$' \
  && ok "fmt: a file that does not parse is still laid out" \
  || bad "fmt: a file that does not parse is still laid out"

# -w writes the file back.
cp "$tmp/messy.vn" "$tmp/inplace.vn"
"$E" fmt -w "$tmp/inplace.vn" 2>/dev/null
cmp -s "$tmp/inplace.vn" "$tmp/laid.vn" \
  && ok "fmt: -w writes the file back" || bad "fmt: -w writes the file back"

# Exit 2 means the check could not run, and it has to look that way: stdout
# stays empty and stderr names the cause. The JSON prologue used to be printed
# before the rule engine opened, so a missing rules directory left an
# unterminated object on stdout -- an editor then said "did not write JSON"
# and threw away the stderr line that said "no rule file in ...".
mkdir -p "$tmp/norules"
out=$("$E" check -t --json --rules "$tmp/norules" "$tmp/good.vn" 2>"$tmp/err")
[ -z "$out" ] && grep -q "no rule file" "$tmp/err" \
  && ok "check: a missing rule set keeps stdout empty and says why" \
  || bad "check: a missing rule set keeps stdout empty and says why (out=[$out])"
out=$("$E" check -t --json --skel /nonexistent "$tmp/good.vn" 2>"$tmp/err")
[ -z "$out" ] && grep -q "skeleton transform" "$tmp/err" \
  && ok "check: a missing skeleton keeps stdout empty and says why" \
  || bad "check: a missing skeleton keeps stdout empty and says why (out=[$out])"

# --no-rules: the reader and the constraints without the rule set. What an
# editor asks at every pause in typing, so it has to be silent about the prose
# rules, loud about the schema, and independent of the rule engine entirely.
"$E" check -t --json --no-rules "$tmp/bad.vn" 2>/dev/null | grep -q "SAIP" \
  && bad "check --no-rules: the rule set stays out of it" \
  || ok "check --no-rules: the rule set stays out of it"
"$E" check -t --json --no-rules "$tmp/bad.vn" >/dev/null 2>&1 \
  && ok "check --no-rules: a rule violation alone passes" \
  || bad "check --no-rules: a rule violation alone passes"
"$E" check -t --json --no-rules "$tmp/short.vn" 2>/dev/null | grep -q '"code": "schema"' \
  && ok "check --no-rules: a constraint failure is still caught" \
  || bad "check --no-rules: a constraint failure is still caught"
"$E" check -t --json --no-rules --skel /nonexistent "$tmp/good.vn" >/dev/null 2>&1 \
  && ok "check --no-rules: never opens the engine, so a broken skeleton cannot stop it" \
  || bad "check --no-rules: never opens the engine, so a broken skeleton cannot stop it"

# version: what an editor compares against its minimum, and what a bug report
# quotes. The number is the contract; the commit is a courtesy.
"$E" version | grep -qE '^euicc [0-9]+\.[0-9]+ \(' \
  && ok "version: euicc says what it is" || bad "version: euicc says what it is"

# fmt -l: the exit code is the answer, so a hook needs no diffing of its own.
"$E" fmt "$tmp/messy.vn" > "$tmp/canon2.vn"
"$E" fmt -l "$tmp/canon2.vn" >/dev/null 2>&1 \
  && ok "fmt -l: a canonical file passes" || bad "fmt -l: a canonical file passes"
"$E" fmt -l "$tmp/messy.vn" >/dev/null 2>&1 \
  && bad "fmt -l: a messy file fails the run" || ok "fmt -l: a messy file fails the run"
lst=$("$E" fmt -l "$tmp/canon2.vn" "$tmp/messy.vn" 2>/dev/null)
[ "$lst" = "$tmp/messy.vn" ] \
  && ok "fmt -l: only the offending file is named" \
  || bad "fmt -l: only the offending file is named ($lst)"
"$E" fmt -l /nonexistent.vn >/dev/null 2>&1
[ $? -eq 2 ] && ok "fmt -l: an unreadable file is exit 2, not a verdict" \
             || bad "fmt -l: an unreadable file is exit 2, not a verdict"

# diff answers in the exit code -- 0 no difference, 1 a difference, 2 could
# not compare -- so a CI gate needs no parsing. Failing to read a file used to
# exit 1, indistinguishable from "the packages differ".
"$E" diff "$tmp/good.vn" "$tmp/good.der" >/dev/null 2>&1
[ $? -eq 0 ] && ok "diff: no difference is exit 0" || bad "diff: no difference is exit 0"
"$E" diff "$tmp/v4.vn" "$tmp/good.der" >/dev/null 2>&1
[ $? -eq 1 ] && ok "diff: a difference is exit 1" || bad "diff: a difference is exit 1"
"$E" diff "$tmp/bad.vn" "$tmp/good.der" >/dev/null 2>&1
[ $? -eq 1 ] && ok "diff: a reordering alone is exit 1" || bad "diff: a reordering alone is exit 1"
"$E" diff /nonexistent "$tmp/good.der" >/dev/null 2>&1
[ $? -eq 2 ] && ok "diff: a missing file is exit 2, not a verdict" \
             || bad "diff: a missing file is exit 2, not a verdict"
"$E" diff "$tmp/unknown.vn" "$tmp/good.der" >/dev/null 2>&1
[ $? -eq 2 ] && ok "diff: an unreadable source is exit 2, not a verdict" \
             || bad "diff: an unreadable source is exit 2, not a verdict"

"$E" diff --json "$tmp/good.vn" "$tmp/good.der" 2>/dev/null | grep -q '"same": true' \
  && ok "diff --json: agreement says so" || bad "diff --json: agreement says so"
out=$("$E" diff --json "$tmp/v4.vn" "$tmp/good.der" 2>/dev/null)
echo "$out" | grep -q '"same": false' \
  && echo "$out" | grep -q '"element": "header"' \
  && ok "diff --json: a change names its element" \
  || bad "diff --json: a change names its element"

# completion: the scripts must track usage(). Every command and flag the usage
# names has to appear in both, so neither can drift without a red run here.
"$E" 2>&1 | sed -n 's/^  \([a-z][a-z-]*\)  .*/\1/p' | sort -u > "$tmp/cmds"
"$E" 2>&1 | sed -n 's/^  \(--*[a-z][a-z-]*\).*/\1/p' | sort -u > "$tmp/flags"
[ -s "$tmp/cmds" ] && [ -s "$tmp/flags" ] \
  && ok "completion: usage yields commands and flags to hold the scripts to" \
  || bad "completion: usage yields commands and flags to hold the scripts to"
for sh in zsh bash; do
  "$E" completion "$sh" > "$tmp/comp.$sh" 2>/dev/null \
    && ok "completion: $sh script is produced" || bad "completion: $sh script is produced"
  missing=""
  while read -r w; do
    grep -q -- "$w" "$tmp/comp.$sh" || missing="$missing $w"
  done < "$tmp/cmds"
  while read -r w; do
    grep -q -- "$w" "$tmp/comp.$sh" || missing="$missing $w"
  done < "$tmp/flags"
  [ -z "$missing" ] && ok "completion: the $sh script knows every command and flag" \
                    || bad "completion: the $sh script is missing$missing"
done
command -v zsh >/dev/null && { zsh -n "$tmp/comp.zsh" \
  && ok "completion: zsh parses its script" || bad "completion: zsh parses its script"; }
command -v bash >/dev/null && { bash -n "$tmp/comp.bash" \
  && ok "completion: bash parses its script" || bad "completion: bash parses its script"; }
"$E" completion fish >/dev/null 2>&1
[ $? -eq 2 ] && ok "completion: an unknown shell is refused" \
             || bad "completion: an unknown shell is refused"

# card: "could not answer" is never a verdict. The first version of this
# test invoked plain "card info" and relied on no reader being attached --
# true in CI and nowhere else, so it failed on any desk that actually has
# the OMNIKEY plugged in (and, as fixed here, would just as wrongly have
# passed in CI for the wrong reason). Naming a reader that cannot exist
# instead drives the same -2/"could not be asked" path deterministically,
# through the real PC/SC stack, regardless of what is or is not plugged in:
# SCardConnect answers SCARD_E_UNKNOWN_READER either way.
out=$("$E" card info --reader "no-such-reader-euicc-tools-tests" 2>&1); rc=$?
[ $rc -eq 2 ] && ok "card info: an unknown reader name is exit 2" \
              || bad "card info: an unknown reader name is exit 2 (got $rc)"
# grep -qi "reader" used to be the assertion here, and could not fail: card.c's
# own wrapper message ("euicc: no card reader is available") contains the word
# "reader" on every open_card failure, present or not, unknown name or none at
# all. rsp_pcsc.c now names the reader it actually failed to find, so assert
# on that name appearing verbatim instead of on a word neither message could
# ever omit.
echo "$out" | grep -q "no-such-reader-euicc-tools-tests" \
  && ok "card info: an unknown reader name is named in the message" \
  || bad "card info: an unknown reader name is named in the message"

# A recording stands in for a card, so the happy path is testable in CI.
"$E" card info --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-info.log" >/dev/null 2>&1 \
  && ok "card info reads a recording" || bad "card info reads a recording"

"$E" card info --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-info.log" --json 2>/dev/null \
  | grep -q '"eid"' && ok "card info --json names the eid" \
                    || bad "card info --json names the eid"

# This project's own test eUICC (the recording above) trusts our test CI:
# the whole round's own reason for existing is that the exit code says so.
"$E" card info --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-info.log" >/dev/null 2>&1
[ $? -eq 0 ] && ok "card info: our test card trusts our test CI, exit 0" \
             || bad "card info: our test card trusts our test CI, exit 0"

# The exit contract can fail, not just succeed: tests/card-no-test-ci.log is
# the same recording with our test CI's identifier edited out of the list
# rsp_card_trusts is asked about (see that file's own header for exactly
# what changed). The card still answers -- this is a real "no", exit 1,
# not "could not be asked".
out=$("$E" card info --replay "$root/tests/card-no-test-ci.log" 2>&1); rc=$?
[ $rc -eq 1 ] && ok "card info: an edited-out CI is exit 1, not 0" \
             || bad "card info: an edited-out CI is exit 1, not 0 (got $rc)"
echo "$out" | grep -qi "does not trust" \
  && ok "card info: the human output says the card does not trust our CI" \
  || bad "card info: the human output says the card does not trust our CI"

# --replay and --reader name two different transports; the command refuses
# to guess which one is meant rather than silently picking one.
"$E" card info --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-info.log" --reader foo >/dev/null 2>&1
[ $? -eq 2 ] && ok "card info: --replay and --reader together is exit 2" \
             || bad "card info: --replay and --reader together is exit 2"

# card profiles: this project's own test eUICC (the recording above) has
# nothing installed at all -- a real and complete answer, exit 0, not a
# failure to find anything.
out=$("$E" card profiles --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-profiles.log" 2>&1); rc=$?
[ $rc -eq 0 ] && ok "card profiles: an empty list is exit 0, not a failure" \
             || bad "card profiles: an empty list is exit 0, not a failure (got $rc)"
echo "$out" | grep -qi "no profiles" \
  && ok "card profiles: the human output says so" \
  || bad "card profiles: the human output says so"

# The populated case, hand-built (testdata/cards/README.md in euicc-rsp
# explains why: the real card above has nothing to pin actual content
# against). Two entries; --json names the fields a script would grep for.
out=$("$E" card profiles --replay "$root/vendor/euicc-lpa/testdata/cards/synthetic-profiles.log" --json 2>/dev/null)
rc=$?
[ $rc -eq 0 ] && ok "card profiles: the populated list is exit 0" \
             || bad "card profiles: the populated list is exit 0 (got $rc)"
echo "$out" | grep -q '"iccid": "8944058925001234567F"' \
  && ok "card profiles --json names the first entry's iccid" \
  || bad "card profiles --json names the first entry's iccid"
echo "$out" | grep -q '"profileName": "Test Telco Postpaid"' \
  && ok "card profiles --json names the first entry's profileName" \
  || bad "card profiles --json names the first entry's profileName"
echo "$out" | grep -q '"iccid": "8944058925009876543F"' \
  && ok "card profiles --json names the second entry's iccid" \
  || bad "card profiles --json names the second entry's iccid"
echo "$out" | grep -q '"profileNickname": null' \
  && ok "card profiles --json: an absent field is null, not a stray guess" \
  || bad "card profiles --json: an absent field is null, not a stray guess"

# card profiles is the first command whose output embeds text the card
# itself chose (profileNickname, serviceProviderName and profileName are
# UTF8String -- see src/card.c's json_string). Every other fixture in
# testdata/cards happens to hold nothing but plain ASCII letters and
# spaces, so a json_string that escaped nothing at all would pass all of
# them. This recording carries the characters a JSON string cannot hold
# raw, and the assertions below pin the escaped forms exactly.
hostile="$root/vendor/euicc-lpa/testdata/cards/synthetic-profiles-hostile-text.log"
out=$("$E" card profiles --replay "$hostile" --json 2>/dev/null); rc=$?
[ $rc -eq 0 ] && ok "card profiles: card-chosen text is exit 0" \
             || bad "card profiles: card-chosen text is exit 0 (got $rc)"
# printf, not echo: /bin/sh's echo expands backslash escapes, so it turns
# the "\\n" and "\t" this output is being checked for into a real
# backslash-n and a real tab before grep ever sees them -- mangling
# exactly the characters under test, and failing three assertions whose
# subject was correct all along. Every other assertion in this file greps
# content with no backslash in it and is unaffected; anything added here
# that does carry one needs printf too.
#
# grep -F, not a pattern: every expected line is pure ASCII precisely
# because the escaping worked, so an exact fixed-string match is
# available and is the strongest pin there is. A raw tab or newline
# reaching the output would break these matches rather than pass them.
printf %s\\n "$out" | grep -qF '"profileNickname": "He said \"hi\" \\n is not a newline\t\u0001"' \
  && ok "card profiles --json escapes quote, backslash, tab and control alike" \
  || bad "card profiles --json escapes quote, backslash, tab and control alike"
printf %s\\n "$out" | grep -qF '"serviceProviderName": "Acme\nTelco"' \
  && ok "card profiles --json escapes a newline the card sent" \
  || bad "card profiles --json escapes a newline the card sent"
# Multi-byte UTF-8 needs no escaping and must survive unmangled: an
# escaper working a byte at a time would corrupt this one.
printf %s\\n "$out" | grep -qF '"profileName": "Grüße 日本"' \
  && ok "card profiles --json leaves multi-byte UTF-8 intact" \
  || bad "card profiles --json leaves multi-byte UTF-8 intact"

# The error variant: a healthy card cannot itself produce this (an
# unrestricted request has nothing incorrect for it to complain about),
# so testdata/cards/omnikey-profiles-error.log is a hand-edited copy of
# the real capture -- see its own header. The eUICC answered and refused:
# exit 1, not 0 and not 2.
out=$("$E" card profiles --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-profiles-error.log" 2>&1); rc=$?
[ $rc -eq 1 ] && ok "card profiles: a decoded refusal is exit 1, not 0 or 2" \
             || bad "card profiles: a decoded refusal is exit 1, not 0 or 2 (got $rc)"
echo "$out" | grep -qi "incorrectInputValues" \
  && ok "card profiles: the human output names which error" \
  || bad "card profiles: the human output names which error"

# --replay and --reader together is exit 2 for profiles too, the same
# refusal card info gives -- cmd_card's own flag validation runs before
# either subcommand, so this is one code path, not two to keep in sync.
"$E" card profiles --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-profiles.log" --reader foo >/dev/null 2>&1
[ $? -eq 2 ] && ok "card profiles: --replay and --reader together is exit 2" \
             || bad "card profiles: --replay and --reader together is exit 2"

# The archive trick (see the Makefile) links two copies of the asn1c
# runtime and the PKIX types, and works only because the copies agree --
# the linker may take either. Nothing checked that until this assertion;
# the Makefile comment claimed a guard that did not exist.
"$root/tools/check-codec-agreement" "$root/vendor/euicc-schema/dist" \
    "$root/vendor/euicc-lpa/vendor/euicc-rsp/dist" >/dev/null 2>&1 \
  && ok "the two generated codecs agree on every shared file" \
  || bad "the two generated codecs agree on every shared file"

# card delete: what makes the install path practisable at all. The exit
# code carries the card's own answer, because SGP.22 5.7.18 gives three
# distinct refusals and they send a reader to three different places.
D="$root/vendor/euicc-lpa/testdata/cards"
out=$("$E" card delete 8944058925001234567F --replay "$D/synthetic-delete-ok.log" 2>&1); rc=$?
[ $rc -eq 0 ] && ok "card delete: a deleted profile is exit 0" \
             || bad "card delete: a deleted profile is exit 0 (got $rc)"
printf %s\\n "$out" | grep -q "deleted 8944058925001234567F" \
  && ok "card delete: it says which one" \
  || bad "card delete: it says which one"

# The refusal a real card actually produces for an installed profile.
out=$("$E" card delete 8944058925001234567F --replay "$D/synthetic-delete-enabled.log" 2>&1); rc=$?
[ $rc -eq 1 ] && ok "card delete: a refusal is exit 1, not 2" \
             || bad "card delete: a refusal is exit 1, not 2 (got $rc)"
printf %s\\n "$out" | grep -q "still enabled" \
  && ok "card delete: the refusal names the reason, not just the failure" \
  || bad "card delete: the refusal names the reason, not just the failure"

# An ICCID is exactly twenty hex digits. A short one silently padded or
# truncated would name a different profile -- caught before any I/O.
"$E" card delete 8944058925001234567 >/dev/null 2>&1
[ $? -eq 2 ] && ok "card delete: a 19-digit ICCID is refused" \
             || bad "card delete: a 19-digit ICCID is refused"
"$E" card delete 8944058925001234ZZZZ >/dev/null 2>&1
[ $? -eq 2 ] && ok "card delete: a non-hex ICCID is refused" \
             || bad "card delete: a non-hex ICCID is refused"
"$E" card delete >/dev/null 2>&1
[ $? -eq 2 ] && ok "card delete: a missing ICCID is refused" \
             || bad "card delete: a missing ICCID is refused"

# card enable: the step that turns an installed profile into one in use.
# omnikey-enable.log is the real session that enabled this project's TS.48
# test profile, so the exit code here rests on a card's own answer.
out=$("$E" card enable 98001032547698103214 --replay "$D/omnikey-enable.log" 2>&1); rc=$?
[ $rc -eq 0 ] && ok "card enable: the real card's enable is exit 0" \
             || bad "card enable: the real card's enable is exit 0 (got $rc)"
printf %s\\n "$out" | grep -q "enabled 98001032547698103214" \
  && ok "card enable: it says which one" \
  || bad "card enable: it says which one"

# card disable: what makes enable reversible. An enabled profile cannot be
# deleted, so without this the card stays as it was left.
out=$("$E" card disable 98001032547698103214 --replay "$D/omnikey-disable.log" 2>&1); rc=$?
[ $rc -eq 0 ] && ok "card disable: the real card's disable is exit 0" \
             || bad "card disable: the real card's disable is exit 0 (got $rc)"
printf %s\\n "$out" | grep -q "disabled 98001032547698103214" \
  && ok "card disable: it says which one" \
  || bad "card disable: it says which one"

# The same ICCID checks delete gets, now that both go through parse_iccid:
# a wrong-length or non-hex ICCID names a different profile, so it is
# refused before any I/O.
"$E" card enable 8944058925001234567 >/dev/null 2>&1
[ $? -eq 2 ] && ok "card enable: a 19-digit ICCID is refused" \
             || bad "card enable: a 19-digit ICCID is refused"
"$E" card enable >/dev/null 2>&1
[ $? -eq 2 ] && ok "card enable: a missing ICCID is refused" \
             || bad "card enable: a missing ICCID is refused"

# card install: a profile whose header demands a capability the card does
# not claim is refused before any of it is sent. omnikey-info.log is the
# real test eUICC's own answer -- uiccCapability '067F36C0'H, eighteen
# declared bits, so nothing from berTlvFileSupport(19) upward. The install
# stops immediately after reading that, which is why an info recording is
# a complete enough transport for this path.
#
# get-identity is the concrete case: GSMA TS.48 v7.0's Generic Test
# Profile lists it as mandatory and this card cannot run it. Before the
# check existed, the eUICC refused only after the whole Bound Profile
# Package had been built, encrypted and sent -- PEStatus
# invalid-parameter(6) against a ProfileHeader PE, which carries no
# identification to name itself by.
cat > "$tmp/needs-get-identity.vn" <<'VN'
value1 ProfileElement ::= header : {
    major-version 2,
    minor-version 3,
    profileType "capability check",
    iccid '89000123456789012341'H,
    eUICC-Mandatory-services { usim NULL, get-identity NULL },
    eUICC-Mandatory-GFSTEList { { 2 23 143 1 2 1 } }
}
value2 ProfileElement ::= end : { end-header { identification 2 } }
VN
"$E" build "$tmp/needs-get-identity.vn" -o "$tmp/needs-get-identity.der" >/dev/null 2>&1 \
  && ok "card install: the capability-check fixture builds" \
  || bad "card install: the capability-check fixture builds"

out=$("$E" card install "$tmp/needs-get-identity.der" \
        --replay "$root/vendor/euicc-lpa/testdata/cards/omnikey-info.log" 2>&1); rc=$?
[ $rc -eq 1 ] && ok "card install: a profile the card cannot run is exit 1, not 2" \
             || bad "card install: a profile the card cannot run is exit 1, not 2 (got $rc)"
printf %s\\n "$out" | grep -q "get-identity" \
  && ok "card install: the refusal names the missing capability" \
  || bad "card install: the refusal names the missing capability"
# usim is asked for too, and this card has it: naming it would turn the
# message into a list of everything the profile wants rather than of what
# is actually wrong.
printf %s\\n "$out" | grep -q "usim" \
  && bad "card install: it names only what is missing, not every service asked for" \
  || ok "card install: it names only what is missing, not every service asked for"

printf '\n%d ok, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
